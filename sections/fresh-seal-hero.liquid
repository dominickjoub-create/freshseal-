{%- comment -%}
  Fresh Seal — Hero (image + offer)
  Self-contained, scoped, and fully editable in the Shopify theme editor.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-accent-dark: {{ section.settings.accent_color_dark }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
  }
  .fs-hero-{{ section.id }} {
    background: var(--fs-bg);
    color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-hero-{{ section.id }} .fs-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  .fs-hero-{{ section.id }} .fs-hero__media img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    display: block;
  }
  .fs-hero-{{ section.id }} .fs-hero__eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--fs-accent);
    margin: 0 0 14px;
  }
  .fs-hero-{{ section.id }} .fs-hero__title {
    font-size: 34px;
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 16px;
  }
  .fs-hero-{{ section.id }} .fs-hero__sub {
    font-size: 17px;
    line-height: 1.55;
    opacity: .82;
    margin: 0 0 24px;
    max-width: 34em;
  }
  .fs-hero-{{ section.id }} .fs-hero__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 22px;
    flex-wrap: wrap;
  }
  .fs-hero-{{ section.id }} .fs-hero__price .now {
    font-size: 30px;
    font-weight: 800;
    color: var(--fs-accent);
  }
  .fs-hero-{{ section.id }} .fs-hero__price .was {
    font-size: 18px;
    text-decoration: line-through;
    opacity: .5;
  }
  .fs-hero-{{ section.id }} .fs-hero__price .save {
    font-size: 13px;
    font-weight: 700;
    background: rgba(45,157,120,.12);
    color: var(--fs-accent-dark);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .fs-hero-{{ section.id }} .fs-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 34px;
    background: var(--fs-accent);
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    border: none;
    border-radius: 12px;
    text-decoration: none;
    cursor: pointer;
    transition: background .18s ease, transform .12s ease;
    width: 100%;
    max-width: 420px;
  }
  .fs-hero-{{ section.id }} .fs-hero__cta:hover { background: var(--fs-accent-dark); }
  .fs-hero-{{ section.id }} .fs-hero__cta:active { transform: translateY(1px); }
  .fs-hero-{{ section.id }} .fs-hero__trust {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .fs-hero-{{ section.id }} .fs-hero__trust li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .fs-hero-{{ section.id }} .fs-hero__trust svg { flex: none; }
  @media screen and (min-width: 900px) {
    .fs-hero-{{ section.id }} .fs-hero__grid {
      grid-template-columns: {% if section.settings.image_position == 'left' %}1fr 1.05fr{% else %}1.05fr 1fr{% endif %};
      gap: 56px;
    }
    .fs-hero-{{ section.id }} .fs-hero__media { order: {% if section.settings.image_position == 'left' %}0{% else %}2{% endif %}; }
    .fs-hero-{{ section.id }} .fs-hero__title { font-size: 46px; }
    .fs-hero-{{ section.id }} .fs-hero__sub { font-size: 18px; }
  }
{%- endstyle -%}

<div class="fs-hero-{{ section.id }}">
  <div class="page-width">
    <div class="fs-hero__grid">
      <div class="fs-hero__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 50vw, 100vw',
            widths: '360, 540, 720, 900, 1100, 1400',
            alt: section.settings.image.alt | default: section.settings.title | escape }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'fs-hero__media img' }}
        {%- endif -%}
      </div>
      <div class="fs-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="fs-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h1 class="fs-hero__title">{{ section.settings.title }}</h1>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="fs-hero__sub">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.price_now != blank -%}
          <div class="fs-hero__price">
            <span class="now">{{ section.settings.price_now }}</span>
            {%- if section.settings.price_was != blank -%}<span class="was">{{ section.settings.price_was }}</span>{%- endif -%}
            {%- if section.settings.save_label != blank -%}<span class="save">{{ section.settings.save_label }}</span>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '#fs-bundle' }}" class="fs-hero__cta">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="fs-hero__trust">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="{{ section.settings.accent_color }}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Seal — Hero",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium 4-in-1 Vacuum Sealer" },
    { "type": "text", "id": "title", "label": "Headline", "default": "Keep food fresh up to 5× longer." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Vacuum-seal, marinate, seal bags and open bottles — one countertop machine that pays for itself in a month of groceries." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "right" },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "price_now", "label": "Price", "default": "R599" },
    { "type": "text", "id": "price_was", "label": "Compare-at price", "default": "R999" },
    { "type": "text", "id": "save_label", "label": "Savings badge", "default": "Save R400" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart — R599" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to jump to the bundle section (#fs-bundle)." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "accent_color_dark", "label": "Accent hover", "default": "#248063" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "trust_point",
      "name": "Trust point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free SA shipping over R700" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — Hero",
      "blocks": [
        { "type": "trust_point", "settings": { "text": "Free SA shipping over R700" } },
        { "type": "trust_point", "settings": { "text": "30-day money-back guarantee" } },
        { "type": "trust_point", "settings": { "text": "12-month warranty" } }
      ]
    }
  ]
}
{% endschema %}
