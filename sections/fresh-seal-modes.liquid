{%- comment -%}
  Fresh Seal — 4-in-1 modes
  Icon cards: Vacuum & Seal / Seal Only / Pulse Vacuum / Jar & Container.
  Mobile: 2x2 grid. Desktop: 1x4 row. All copy editable per block.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
    --fs-card: {{ section.settings.card_color }};
  }
  .fs-modes-{{ section.id }} {
    background: var(--fs-bg); color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-modes-{{ section.id }} .fs-modes__head { text-align: center; max-width: 38em; margin: 0 auto 30px; }
  .fs-modes-{{ section.id }} .fs-modes__title { font-size: 26px; font-weight: 800; letter-spacing: -.01em; margin: 0 0 8px; text-transform: uppercase; }
  .fs-modes-{{ section.id }} .fs-modes__intro { font-size: 15px; color: #555; margin: 0; }
  .fs-modes-{{ section.id }} .fs-modes__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .fs-modes-{{ section.id }} .fs-mode {
    background: var(--fs-card); border: 1px solid #ececec; border-radius: 16px;
    padding: 24px 18px; text-align: center;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .fs-modes-{{ section.id }} .fs-mode:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.06); }
  .fs-modes-{{ section.id }} .fs-mode__icon {
    width: 52px; height: 52px; margin: 0 auto 14px; border-radius: 14px;
    background: rgba(45,157,120,.12); color: var(--fs-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .fs-modes-{{ section.id }} .fs-mode__title { font-size: 16px; font-weight: 800; margin: 0 0 6px; }
  .fs-modes-{{ section.id }} .fs-mode__desc { font-size: 13.5px; line-height: 1.5; color: #555; margin: 0; }
  @media screen and (min-width: 750px) {
    .fs-modes-{{ section.id }} .fs-modes__title { font-size: 32px; }
    .fs-modes-{{ section.id }} .fs-modes__grid { grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .fs-modes-{{ section.id }} .fs-mode { padding: 30px 22px; }
  }
  @media screen and (max-width: 480px) {
    .fs-modes-{{ section.id }} .fs-modes__title { font-size: 23px; }
    .fs-modes-{{ section.id }} .fs-modes__head { margin-bottom: 22px; }
    .fs-modes-{{ section.id }} .fs-modes__grid { gap: 10px; }
    .fs-modes-{{ section.id }} .fs-mode { padding: 20px 14px; }
    .fs-modes-{{ section.id }} .fs-mode__icon { width: 46px; height: 46px; margin-bottom: 12px; }
    .fs-modes-{{ section.id }} .fs-mode__desc { font-size: 13px; }
  }
{%- endstyle -%}

<div class="fs-modes-{{ section.id }}">
  <div class="page-width">
    <div class="fs-modes__head">
      {%- if section.settings.title != blank -%}<h2 class="fs-modes__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="fs-modes__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
    <div class="fs-modes__grid">
      {%- for block in section.blocks -%}
        <div class="fs-mode" {{ block.shopify_attributes }}>
          <span class="fs-mode__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'seal' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="3" y="9" width="18" height="6" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M6 12h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="2 3"/></svg>
              {%- when 'pulse' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 12h4l2-6 4 12 2-6h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'jar' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="6" y="7" width="12" height="14" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M8 4h8M8 11h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              {%- else -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 1 1 2.3 5.6M4 12V7m0 5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </span>
          <h3 class="fs-mode__title">{{ block.settings.title }}</h3>
          {%- if block.settings.description != blank -%}<p class="fs-mode__desc">{{ block.settings.description }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Seal — 4-in-1 modes",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "One machine. Four jobs." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Every mode you actually use — nothing you don't." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#F5F5F5" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Mode card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "vacuum", "label": "Vacuum (cycle)" },
          { "value": "seal", "label": "Seal (bar)" },
          { "value": "pulse", "label": "Pulse (wave)" },
          { "value": "jar", "label": "Jar / container" }
        ], "default": "vacuum" },
        { "type": "text", "id": "title", "label": "Title", "default": "Vacuum & Seal" },
        { "type": "text", "id": "description", "label": "Description", "default": "One press. Air out, sealed tight." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — 4-in-1 modes",
      "blocks": [
        { "type": "mode", "settings": { "icon": "vacuum", "title": "Vacuum & Seal", "description": "One press. Air out, sealed tight. Your default for meat, cheese and leftovers." } },
        { "type": "mode", "settings": { "icon": "seal", "title": "Seal Only", "description": "Reseal chip packets and open bags — no vacuum, just a clean seal." } },
        { "type": "mode", "settings": { "icon": "pulse", "title": "Pulse Vacuum", "description": "You control the suction. Perfect for soft foods — no crushed bread or biltong crumbs." } },
        { "type": "mode", "settings": { "icon": "jar", "title": "Jar & Container", "description": "Vacuum jars, canisters and bottles with the included hose. Wine stays good for weeks." } }
      ]
    }
  ]
}
{% endschema %}
