{%- comment -%}
  FreshSeal — Product compare (Bloom-style tab card)
  Attached tab bar: active tab = solid black with rounded top corners,
  inactive tabs on light grey with thin vertical dividers. White content
  panel below. Tabs switch with no reload. All content editable via blocks.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fspc-active: {{ section.settings.active_tab_color }};
    --fspc-yes: {{ section.settings.check_color }};
    --fspc-no: {{ section.settings.cross_color }};
    --fspc-text: {{ section.settings.text_color }};
    --fspc-muted: #757575;
    --fspc-line: #e5e5e5;
  }
  .fspc-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: var(--fspc-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fspc-{{ section.id }} .fspc__card {
    max-width: 640px; margin: 0 auto;
    background: #ffffff;
    border: 1px solid var(--fspc-line);
    border-radius: 12px;
    box-shadow: 0 6px 22px rgba(0,0,0,.05);
    overflow: hidden;
  }
  /* Tab bar */
  .fspc-{{ section.id }} .fspc__nav {
    display: flex; align-items: stretch;
    background: #f4f4f4;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .fspc-{{ section.id }} .fspc__nav::-webkit-scrollbar { display: none; }
  .fspc-{{ section.id }} .fspc__tab {
    position: relative;
    flex: 1 0 auto;
    min-height: 54px;
    padding: 8px 20px;
    border: none; background: transparent;
    color: var(--fspc-muted);
    font-family: inherit;
    font-size: 15px; font-weight: 600; line-height: 1.25;
    cursor: pointer; white-space: normal;
    transition: color .15s ease;
  }
  .fspc-{{ section.id }} .fspc__tab:hover { color: var(--fspc-text); }
  /* thin divider between inactive neighbours */
  .fspc-{{ section.id }} .fspc__tab:not(.is-active) + .fspc__tab:not(.is-active)::before {
    content: ""; position: absolute; left: 0; top: 28%; bottom: 28%; width: 1px; background: #d9d9d9;
  }
  .fspc-{{ section.id }} .fspc__tab.is-active {
    background: var(--fspc-active);
    color: #ffffff;
    font-weight: 700;
    border-radius: 10px 10px 0 0;
  }
  /* Panels */
  .fspc-{{ section.id }} .fspc__panel { display: none; background: #ffffff; padding: 30px 26px 34px; }
  .fspc-{{ section.id }} .fspc__panel.is-active { display: block; animation: fspcFade-{{ section.id }} .2s ease; }
  @keyframes fspcFade-{{ section.id }} { from { opacity: 0; } to { opacity: 1; } }
  .fspc-{{ section.id }} .fspc__heading { font-size: 20px; font-weight: 700; margin: 0 0 14px; }
  .fspc-{{ section.id }} .fspc__text { font-size: 16.5px; line-height: 1.65; margin: 0; color: var(--fspc-text); }
  .fspc-{{ section.id }} .fspc__text p { margin: 0 0 12px; }
  .fspc-{{ section.id }} .fspc__text p:last-child { margin-bottom: 0; }

  /* Us vs Them table */
  .fspc-{{ section.id }} .fspc__cmp { width: 100%; border-collapse: collapse; }
  .fspc-{{ section.id }} .fspc__cmp th { padding: 4px 8px 14px; text-align: center; vertical-align: middle; }
  .fspc-{{ section.id }} .fspc__cmp th:first-child { text-align: left; }
  .fspc-{{ section.id }} .fspc__cmp td {
    padding: 14px 8px; text-align: center; vertical-align: middle;
    border-top: 1px solid var(--fspc-line);
    font-size: 15px;
  }
  .fspc-{{ section.id }} .fspc__cmp td:first-child { text-align: left; color: var(--fspc-text); }
  .fspc-{{ section.id }} .fspc__uslogo {
    display: inline-flex; align-items: center; justify-content: center;
    background: #fafafa; border-radius: 12px; padding: 10px 14px;
  }
  .fspc-{{ section.id }} .fspc__uslogo img { max-height: 30px; width: auto; display: block; }
  .fspc-{{ section.id }} .fspc__usname { font-size: 16px; font-weight: 800; }
  .fspc-{{ section.id }} .fspc__themname { font-size: 16px; font-weight: 700; color: var(--fspc-muted); }
  .fspc-{{ section.id }} .fspc__yes svg, .fspc-{{ section.id }} .fspc__no svg { display: inline-block; vertical-align: middle; }

  /* Included list */
  .fspc-{{ section.id }} .fspc__inc { list-style: none; margin: 0; padding: 0; }
  .fspc-{{ section.id }} .fspc__inc-head {
    background: #fafafa; font-weight: 700; font-size: 17px;
    padding: 16px 14px; border-radius: 8px 8px 0 0; margin: 0;
  }
  .fspc-{{ section.id }} .fspc__inc li { font-size: 16px; padding: 16px 14px; border-bottom: 1px solid var(--fspc-line); }
  .fspc-{{ section.id }} .fspc__inc li:last-child { border-bottom: none; }

  /* Benefits list */
  .fspc-{{ section.id }} .fspc__ben { list-style: none; margin: 0; padding: 0; }
  .fspc-{{ section.id }} .fspc__ben li {
    display: flex; align-items: center; gap: 16px;
    font-size: 16.5px; padding: 15px 2px; border-bottom: 1px solid var(--fspc-line);
  }
  .fspc-{{ section.id }} .fspc__ben li:last-child { border-bottom: none; }
  .fspc-{{ section.id }} .fspc__ben .dot {
    flex: none; width: 36px; height: 36px; border-radius: 50%;
    background: #ededed; color: var(--fspc-text);
    display: flex; align-items: center; justify-content: center;
  }
  @media screen and (max-width: 480px) {
    .fspc-{{ section.id }} .fspc__tab { padding: 8px 14px; font-size: 13.5px; }
    .fspc-{{ section.id }} .fspc__panel { padding: 24px 18px 26px; }
  }
{%- endstyle -%}

<div class="fspc-{{ section.id }}" id="fspc-{{ section.id }}">
  <div class="page-width">
    <div class="fspc__card">
      <div class="fspc__nav" role="tablist" aria-label="{{ section.settings.aria_label | default: 'Product information' }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="fspc__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            id="fspc-tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="fspc-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label }}</button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <div
          class="fspc__panel{% if forloop.first %} is-active{% endif %}"
          id="fspc-panel-{{ section.id }}-{{ forloop.index }}"
          role="tabpanel"
          aria-labelledby="fspc-tab-{{ section.id }}-{{ forloop.index }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- case block.type -%}

            {%- when 'text_tab' -%}
              {%- if block.settings.heading != blank -%}<h3 class="fspc__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <div class="fspc__text">{{ block.settings.content }}</div>

            {%- when 'compare' -%}
              <table class="fspc__cmp">
                <thead>
                  <tr>
                    <th></th>
                    <th>
                      {%- if block.settings.us_logo != blank -%}
                        <span class="fspc__uslogo">{{ block.settings.us_logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.col_us | escape }}</span>
                      {%- else -%}
                        <span class="fspc__usname">{{ block.settings.col_us }}</span>
                      {%- endif -%}
                    </th>
                    <th><span class="fspc__themname">{{ block.settings.col_them }}</span></th>
                  </tr>
                </thead>
                <tbody>
                  {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                  {%- for row in rows -%}
                    {%- assign cells = row | strip | split: '|' -%}
                    {%- if cells.size >= 3 -%}
                      <tr>
                        <td>{{ cells[0] | strip }}</td>
                        {%- for ci in (1..2) -%}
                          {%- assign v = cells[ci] | strip | downcase -%}
                          <td>
                            {%- if v == 'yes' -%}
                              <span class="fspc__yes"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-label="Yes"><path d="M20 6.5 9.4 17 4 11.8" stroke="var(--fspc-yes)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                            {%- elsif v == 'no' -%}
                              <span class="fspc__no"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="No"><path d="M6 6l12 12M18 6 6 18" stroke="var(--fspc-no)" stroke-width="2.6" stroke-linecap="round"/></svg></span>
                            {%- else -%}
                              {{ cells[ci] | strip }}
                            {%- endif -%}
                          </td>
                        {%- endfor -%}
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>

            {%- when 'included' -%}
              <ul class="fspc__inc">
                {%- if block.settings.heading != blank -%}<li class="fspc__inc-head" style="border-bottom:1px solid var(--fspc-line)">{{ block.settings.heading }}</li>{%- endif -%}
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}
                  {%- assign line = item | strip -%}
                  {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'benefits' -%}
              {%- if block.settings.heading != blank -%}<h3 class="fspc__heading" style="font-size:26px;font-weight:800">{{ block.settings.heading }}</h3>{%- endif -%}
              <ul class="fspc__ben">
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}
                  {%- assign line = item | strip -%}
                  {%- if line != blank -%}
                    <li>
                      <span class="dot"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6.5 9.4 17 4 11.8" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                      <span>{{ line }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fspc-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.fspc__tab');
    var panels = root.querySelectorAll('.fspc__panel');
    function activate(i) {
      tabs.forEach(function (t, idx) {
        var on = idx === i;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      panels.forEach(function (p, idx) {
        var on = idx === i;
        p.classList.toggle('is-active', on);
        if (on) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { activate(i); });
      t.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          var n = e.key === 'ArrowRight' ? (i + 1) % tabs.length : (i - 1 + tabs.length) % tabs.length;
          tabs[n].focus(); activate(n);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FreshSeal product compare",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFF9F0" },
    { "type": "color", "id": "active_tab_color", "label": "Active tab", "default": "#1A1A1A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "check_color", "label": "Checkmark", "default": "#4CAF50" },
    { "type": "color", "id": "cross_color", "label": "Cross", "default": "#E53935" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "text_tab",
      "name": "Tab — Text / Why",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Why FreshSeal?" },
        { "type": "text", "id": "heading", "label": "Panel heading (optional)" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>FreshSeal keeps food fresh up to 5× longer — protecting your groceries from freezer burn from day one. You'll feel the difference on your very first bulk shop.</p>" }
      ]
    },
    {
      "type": "compare",
      "name": "Tab — Us vs Them",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Us vs Them" },
        { "type": "image_picker", "id": "us_logo", "label": "Your logo (column header)", "info": "Optional — falls back to the text below." },
        { "type": "text", "id": "col_us", "label": "Your column label", "default": "FreshSeal" },
        { "type": "text", "id": "col_them", "label": "Their column label", "default": "Knockoffs" },
        { "type": "textarea", "id": "rows", "label": "Rows (Feature | You | Them)", "info": "One per line. 'yes' = green check, 'no' = red cross, or any short text.", "default": "works with any bag or roll | yes | no\n4-in-1 modes in one machine | yes | no\nkeeps food fresh 5× longer | yes | no\n12-month warranty and SA support | yes | no" }
      ]
    },
    {
      "type": "included",
      "name": "Tab — What's Included",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "What's Included" },
        { "type": "text", "id": "heading", "label": "List heading", "default": "In the box" },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "1× FreshSeal 4-in-1 Vacuum Sealer\n51× Vacuum Bags\n1× Jar & Bottle Accessory Hose\n1× Quick-Start Guide" }
      ]
    },
    {
      "type": "benefits",
      "name": "Tab — Benefits",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Benefits" },
        { "type": "text", "id": "heading", "label": "Panel heading", "default": "Key Benefits" },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "5× Longer Freshness\nNo More Freezer Burn\nWorks With Any Bag\nSaves On Every Grocery Run" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FreshSeal product compare",
      "blocks": [
        { "type": "text_tab" },
        { "type": "compare" },
        { "type": "included" },
        { "type": "benefits" }
      ]
    }
  ]
}
{% endschema %}
