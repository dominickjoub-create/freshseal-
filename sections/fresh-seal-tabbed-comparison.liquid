{%- comment -%}
  Fresh Seal — Tabbed comparison (compact)
  Tabs: Why Fresh Seal? | Us vs Them | What's Included | Benefits
  Black active pill, scrollable tabs, single compact card, content switches
  on tap (no reload). Fully editable via blocks.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-active: {{ section.settings.active_tab_color }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
    --fs-card: {{ section.settings.card_color }};
    --fs-tabbar: {{ section.settings.tabbar_color }};
    --fs-line: rgba(0,0,0,.09);
    --fs-no: {{ section.settings.negative_color }};
  }
  .fs-tabs-{{ section.id }} {
    background: var(--fs-bg);
    color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-tabs-{{ section.id }} .fs-tabs__head { text-align: center; max-width: 40em; margin: 0 auto 20px; }
  .fs-tabs-{{ section.id }} .fs-tabs__title { font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin: 0 0 8px; }
  .fs-tabs-{{ section.id }} .fs-tabs__intro { font-size: 15px; opacity: .75; margin: 0; }

  .fs-tabs-{{ section.id }} .fs-tabs__card {
    max-width: 620px; margin: 0 auto;
    border: 1px solid var(--fs-line); border-radius: 18px; overflow: hidden;
    background: var(--fs-card);
    box-shadow: 0 10px 30px rgba(0,0,0,.05);
  }
  /* Tab bar */
  .fs-tabs-{{ section.id }} .fs-tabs__nav {
    display: flex; align-items: stretch;
    background: var(--fs-tabbar);
    padding: 8px;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .fs-tabs-{{ section.id }} .fs-tabs__nav::-webkit-scrollbar { display: none; }
  .fs-tabs-{{ section.id }} .fs-tabs__btn {
    position: relative;
    flex: 1 0 auto;
    min-height: 52px;
    padding: 6px 18px;
    border: none; background: transparent;
    color: {{ section.settings.text_color }}; opacity: .55;
    font-size: 15px; font-weight: 700; line-height: 1.2;
    border-radius: 12px;
    cursor: pointer; white-space: normal;
    transition: background .18s ease, color .18s ease, opacity .18s ease;
  }
  /* thin divider between inactive tabs */
  .fs-tabs-{{ section.id }} .fs-tabs__btn:not([aria-selected="true"]) + .fs-tabs__btn:not([aria-selected="true"])::before {
    content: ""; position: absolute; left: 0; top: 22%; bottom: 22%; width: 1px; background: var(--fs-line);
  }
  .fs-tabs-{{ section.id }} .fs-tabs__btn[aria-selected="true"] {
    background: var(--fs-active); color: #fff; opacity: 1;
    box-shadow: 0 4px 12px rgba(0,0,0,.18);
  }
  /* Panels */
  .fs-tabs-{{ section.id }} .fs-tabs__body { padding: 26px 22px 28px; }
  .fs-tabs-{{ section.id }} .fs-tabs__panel { display: none; }
  .fs-tabs-{{ section.id }} .fs-tabs__panel.is-active { display: block; animation: fs-fade-{{ section.id }} .22s ease; }
  @keyframes fs-fade-{{ section.id }} { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  .fs-tabs-{{ section.id }} .fs-panel-heading { font-size: 22px; font-weight: 800; letter-spacing: -.01em; margin: 0 0 16px; }
  .fs-tabs-{{ section.id }} .fs-panel-text { font-size: 17px; line-height: 1.55; margin: 0; opacity: .9; }

  /* Comparison table */
  .fs-tabs-{{ section.id }} .fs-cmp { width: 100%; border-collapse: collapse; font-size: 16px; }
  .fs-tabs-{{ section.id }} .fs-cmp th, .fs-tabs-{{ section.id }} .fs-cmp td { padding: 15px 8px; text-align: center; border-bottom: 1px solid var(--fs-line); vertical-align: middle; }
  .fs-tabs-{{ section.id }} .fs-cmp tr:last-child td { border-bottom: none; }
  .fs-tabs-{{ section.id }} .fs-cmp th:first-child, .fs-tabs-{{ section.id }} .fs-cmp td:first-child { text-align: left; }
  .fs-tabs-{{ section.id }} .fs-cmp thead th { font-weight: 800; padding-bottom: 18px; }
  .fs-tabs-{{ section.id }} .fs-cmp .fs-us-logo { max-height: 26px; width: auto; display: inline-block; }
  .fs-tabs-{{ section.id }} .fs-cmp .col-us { color: var(--fs-accent); }
  .fs-tabs-{{ section.id }} .fs-cmp .col-them { color: rgba(0,0,0,.55); }
  .fs-tabs-{{ section.id }} .fs-cmp .yes { color: #22a565; font-size: 22px; font-weight: 800; }
  .fs-tabs-{{ section.id }} .fs-cmp .no { color: var(--fs-no); font-size: 20px; font-weight: 800; }

  /* Included list */
  .fs-tabs-{{ section.id }} .fs-inc { list-style: none; margin: 0; padding: 0; }
  .fs-tabs-{{ section.id }} .fs-inc li { font-size: 17px; padding: 15px 2px; border-bottom: 1px solid var(--fs-line); }
  .fs-tabs-{{ section.id }} .fs-inc li:last-child { border-bottom: none; }
  .fs-tabs-{{ section.id }} .fs-inc .qty { font-weight: 700; }

  /* Benefits list */
  .fs-tabs-{{ section.id }} .fs-ben { list-style: none; margin: 0; padding: 0; }
  .fs-tabs-{{ section.id }} .fs-ben li { display: flex; align-items: center; gap: 14px; font-size: 17px; padding: 14px 2px; border-bottom: 1px solid var(--fs-line); }
  .fs-tabs-{{ section.id }} .fs-ben li:last-child { border-bottom: none; }
  .fs-tabs-{{ section.id }} .fs-ben .tick {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: rgba(45,157,120,.14); color: var(--fs-accent);
    display: flex; align-items: center; justify-content: center;
  }

  .fs-tabs-{{ section.id }} .fs-panel-note {
    margin: 18px 0 0; padding: 13px 15px; border-radius: 11px;
    background: rgba(45,157,120,.09); color: var(--fs-accent);
    font-size: 14px; font-weight: 700;
  }
  @media screen and (min-width: 750px) {
    .fs-tabs-{{ section.id }} .fs-tabs__title { font-size: 32px; }
    .fs-tabs-{{ section.id }} .fs-tabs__btn { flex: 1 1 0; }
  }
{%- endstyle -%}

<div class="fs-tabs-{{ section.id }}" id="fs-tabs-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.intro != blank -%}
      <div class="fs-tabs__head">
        {%- if section.settings.title != blank -%}<h2 class="fs-tabs__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="fs-tabs__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="fs-tabs__card">
      <div class="fs-tabs__nav" role="tablist" aria-label="Comparison tabs">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="fs-tabs__btn"
            role="tab"
            id="fs-tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="fs-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label }}</button>
        {%- endfor -%}
      </div>

      <div class="fs-tabs__body">
        {%- for block in section.blocks -%}
          <div
            class="fs-tabs__panel{% if forloop.first %} is-active{% endif %}"
            id="fs-panel-{{ section.id }}-{{ forloop.index }}"
            role="tabpanel"
            aria-labelledby="fs-tab-{{ section.id }}-{{ forloop.index }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- case block.type -%}

              {%- when 'text_tab' -%}
                {%- if block.settings.heading != blank -%}<h3 class="fs-panel-heading">{{ block.settings.heading }}</h3>{%- endif -%}
                <div class="fs-panel-text">{{ block.settings.content }}</div>

              {%- when 'compare' -%}
                {%- if block.settings.heading != blank -%}<h3 class="fs-panel-heading">{{ block.settings.heading }}</h3>{%- endif -%}
                <table class="fs-cmp">
                  <thead>
                    <tr>
                      <th></th>
                      <th class="col-us">
                        {%- if block.settings.us_logo != blank -%}
                          {{ block.settings.us_logo | image_url: width: 200 | image_tag: class: 'fs-us-logo', loading: 'lazy', alt: block.settings.col_us | escape }}
                        {%- else -%}{{ block.settings.col_us }}{%- endif -%}
                      </th>
                      <th class="col-them">{{ block.settings.col_them }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                    {%- for row in rows -%}
                      {%- assign cells = row | strip | split: '|' -%}
                      {%- if cells.size >= 3 -%}
                        <tr>
                          <td>{{ cells[0] | strip }}</td>
                          <td>{%- assign u = cells[1] | strip | downcase -%}{%- if u == 'yes' -%}<span class="yes">✓</span>{%- elsif u == 'no' -%}<span class="no">✕</span>{%- else -%}{{ cells[1] | strip }}{%- endif -%}</td>
                          <td>{%- assign t = cells[2] | strip | downcase -%}{%- if t == 'yes' -%}<span class="yes">✓</span>{%- elsif t == 'no' -%}<span class="no">✕</span>{%- else -%}{{ cells[2] | strip }}{%- endif -%}</td>
                        </tr>
                      {%- endif -%}
                    {%- endfor -%}
                  </tbody>
                </table>

              {%- when 'included' -%}
                {%- if block.settings.heading != blank -%}<h3 class="fs-panel-heading">{{ block.settings.heading }}</h3>{%- endif -%}
                <ul class="fs-inc">
                  {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                  {%- for item in items -%}
                    {%- assign line = item | strip -%}
                    {%- if line != blank -%}
                      {%- assign parts = line | split: '×' -%}
                      <li>{%- if parts.size > 1 -%}<span class="qty">{{ parts[0] | strip }}×</span> {{ parts[1] | strip }}{%- else -%}{{ line }}{%- endif -%}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'benefits' -%}
                {%- if block.settings.heading != blank -%}<h3 class="fs-panel-heading">{{ block.settings.heading }}</h3>{%- endif -%}
                <ul class="fs-ben">
                  {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                  {%- for item in items -%}
                    {%- assign line = item | strip -%}
                    {%- if line != blank -%}
                      <li>
                        <span class="tick"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span>{{ line }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

            {%- endcase -%}

            {%- if block.settings.note != blank -%}<p class="fs-panel-note">{{ block.settings.note }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fs-tabs-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.fs-tabs__btn');
    var panels = root.querySelectorAll('.fs-tabs__panel');
    function activate(i) {
      tabs.forEach(function (t, idx) {
        var on = idx === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      panels.forEach(function (p, idx) {
        var on = idx === i;
        p.classList.toggle('is-active', on);
        if (on) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
      });
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { activate(i); });
      t.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          var next = e.key === 'ArrowRight' ? (i + 1) % tabs.length : (i - 1 + tabs.length) % tabs.length;
          tabs[next].focus(); activate(next);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Fresh Seal — Tabbed comparison",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Everything you need to know" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Tap through — compact, scannable, no scrolling." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "active_tab_color", "label": "Active tab", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "negative_color", "label": "Cross / negative", "default": "#E4322B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "tabbar_color", "label": "Tab bar background", "default": "#F2F2F2" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "text_tab",
      "name": "Tab — Text / Why",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Why Fresh Seal?" },
        { "type": "text", "id": "heading", "label": "Panel heading (optional)" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>The Fresh Seal 4-in-1 machine vacuum-seals, marinates, seals bags and opens bottles — keeping food fresh up to 5× longer. You'll notice the difference the very first time you seal.</p>" },
        { "type": "text", "id": "note", "label": "Highlight note (optional)" }
      ]
    },
    {
      "type": "compare",
      "name": "Tab — Us vs Them",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Us vs Them" },
        { "type": "text", "id": "heading", "label": "Panel heading (optional)" },
        { "type": "image_picker", "id": "us_logo", "label": "Your logo (column header)", "info": "Optional. Falls back to the text below." },
        { "type": "text", "id": "col_us", "label": "Your column label", "default": "Fresh Seal" },
        { "type": "text", "id": "col_them", "label": "Their column label", "default": "Knockoffs" },
        { "type": "textarea", "id": "rows", "label": "Rows (Feature | You | Them)", "info": "One per line. Type 'yes' / 'no' for green tick / red cross, or any short text.", "default": "4-in-1 functionality | yes | no\nStrong double-seal strip | yes | no\n51 bags included | yes | no\n12-month warranty | yes | no\nSA-based support | yes | no" },
        { "type": "text", "id": "note", "label": "Highlight note (optional)", "default": "Priced like a starter sealer. Built like a premium one." }
      ]
    },
    {
      "type": "included",
      "name": "Tab — What's Included",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "What's Included" },
        { "type": "text", "id": "heading", "label": "Panel heading", "default": "In the box" },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "info": "Start with a quantity like '1×' to bold it, e.g. 1× Fresh Seal Machine.", "default": "1× Fresh Seal 4-in-1 Machine\n51× Vacuum-Seal Bags\n1× Bottle Stopper + Accessory Hose\n1× Quick-Start Guide" },
        { "type": "text", "id": "note", "label": "Highlight note (optional)" }
      ]
    },
    {
      "type": "benefits",
      "name": "Tab — Benefits",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Benefits" },
        { "type": "text", "id": "heading", "label": "Panel heading", "default": "Key Benefits" },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "5× longer freshness\nLess grocery waste, more savings\nPrecision portioning for meal prep\nNo more freezer burn" },
        { "type": "text", "id": "note", "label": "Highlight note (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — Tabbed comparison",
      "blocks": [
        { "type": "text_tab" },
        { "type": "compare" },
        { "type": "included" },
        { "type": "benefits" }
      ]
    }
  ]
}
{% endschema %}
