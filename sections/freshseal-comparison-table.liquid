{%- comment -%}
  FreshSeal — Comparison table
  Split layout: big heading + supporting text on the left, rounded table
  card on the right. First column cells are solid green with white text,
  "FreshSeal" and "OTHERS" headers sit above the card, green checks and
  dark crosses in the value columns. Rows are editable blocks.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fsct-green: {{ section.settings.benefit_color }};
    --fsct-yes: {{ section.settings.check_color }};
    --fsct-no: {{ section.settings.cross_color }};
    --fsct-text: {{ section.settings.text_color }};
  }
  .fsct-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: var(--fsct-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fsct-{{ section.id }} .fsct__grid {
    display: grid; grid-template-columns: 1fr; gap: 34px; align-items: center;
  }
  .fsct-{{ section.id }} .fsct__title {
    font-size: 34px; font-weight: 800; letter-spacing: -.02em;
    margin: 0 0 14px; text-align: center;
  }
  .fsct-{{ section.id }} .fsct__text { font-size: 15.5px; line-height: 1.6; color: #555555; margin: 0; text-align: center; }
  .fsct-{{ section.id }} .fsct__tablewrap { max-width: 480px; margin: 0 auto; width: 100%; }
  .fsct-{{ section.id }} .fsct__table { width: 100%; border-collapse: separate; border-spacing: 0; }
  .fsct-{{ section.id }} .fsct__table thead th {
    padding: 0 10px 12px; text-align: center;
    font-size: 14px; font-weight: 800; color: var(--fsct-text);
  }
  .fsct-{{ section.id }} .fsct__table thead th.them { text-transform: uppercase; font-size: 13px; letter-spacing: .02em; }
  .fsct-{{ section.id }} .fsct__card-start td { border-top: 1px solid #efefef; }
  .fsct-{{ section.id }} .fsct__table td {
    background: #ffffff;
    padding: 13px 10px; text-align: center; vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
    box-shadow: 0 10px 26px rgba(0,0,0,.04);
  }
  .fsct-{{ section.id }} .fsct__table td.benefit {
    background: var(--fsct-green);
    color: #ffffff; font-weight: 700; font-size: 14.5px;
    text-align: center; padding: 13px 18px;
    border-bottom: 1px solid rgba(255,255,255,.22);
    width: 40%;
  }
  /* rounded card corners */
  .fsct-{{ section.id }} tbody tr:first-child td.benefit { border-radius: 14px 0 0 0; }
  .fsct-{{ section.id }} tbody tr:first-child td:last-child { border-radius: 0 14px 0 0; }
  .fsct-{{ section.id }} tbody tr:last-child td.benefit { border-radius: 0 0 0 14px; border-bottom: none; }
  .fsct-{{ section.id }} tbody tr:last-child td:last-child { border-radius: 0 0 14px 0; }
  .fsct-{{ section.id }} tbody tr:last-child td { border-bottom: none; }
  .fsct-{{ section.id }} .fsct__mark svg { display: inline-block; vertical-align: middle; }
  @media screen and (min-width: 900px) {
    .fsct-{{ section.id }} .fsct__grid { grid-template-columns: 1fr 1fr; gap: 60px; }
    .fsct-{{ section.id }} .fsct__title { font-size: 46px; text-align: left; }
    .fsct-{{ section.id }} .fsct__text { text-align: left; }
    .fsct-{{ section.id }} .fsct__tablewrap { margin: 0 0 0 auto; }
  }
  @media screen and (max-width: 480px) {
    .fsct-{{ section.id }} .fsct__grid { gap: 24px; }
    .fsct-{{ section.id }} .fsct__title { font-size: 28px; }
    .fsct-{{ section.id }} .fsct__text { font-size: 14.5px; }
    .fsct-{{ section.id }} .fsct__table thead th { font-size: 13px; padding-bottom: 10px; }
    .fsct-{{ section.id }} .fsct__table td { padding: 12px 6px; }
    .fsct-{{ section.id }} .fsct__table td.benefit { font-size: 13px; padding: 12px 12px; width: 46%; }
  }
{%- endstyle -%}

<div class="fsct-{{ section.id }}">
  <div class="page-width">
    <div class="fsct__grid">
      <div>
        {%- if section.settings.title != blank -%}<h2 class="fsct__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="fsct__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="fsct__tablewrap">
        <table class="fsct__table">
          <thead>
            <tr>
              <th></th>
              <th>{{ section.settings.col_us }}</th>
              <th class="them">{{ section.settings.col_them }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <td class="benefit">{{ block.settings.label }}</td>
                <td>
                  <span class="fsct__mark">
                    {%- if block.settings.us -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-label="Yes"><path d="M20 6.5 9.4 17 4 11.8" stroke="var(--fsct-yes)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- else -%}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-label="No"><path d="M6 6l12 12M18 6 6 18" stroke="var(--fsct-no)" stroke-width="2.8" stroke-linecap="round"/></svg>
                    {%- endif -%}
                  </span>
                </td>
                <td>
                  <span class="fsct__mark">
                    {%- if block.settings.them -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-label="Yes"><path d="M20 6.5 9.4 17 4 11.8" stroke="var(--fsct-yes)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- else -%}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-label="No"><path d="M6 6l12 12M18 6 6 18" stroke="var(--fsct-no)" stroke-width="2.8" stroke-linecap="round"/></svg>
                    {%- endif -%}
                  </span>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FreshSeal comparison table",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Comparison table" },
    { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Talk about how and why is your brand better than the others." },
    { "type": "text", "id": "col_us", "label": "Your column label", "default": "FreshSeal" },
    { "type": "text", "id": "col_them", "label": "Their column label", "default": "OTHERS" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "benefit_color", "label": "Benefit column", "default": "#3D9970" },
    { "type": "color", "id": "check_color", "label": "Checkmark", "default": "#2E9E44" },
    { "type": "color", "id": "cross_color", "label": "Cross", "default": "#1A1A1A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Benefit", "default": "Benefit" },
        { "type": "checkbox", "id": "us", "label": "Your column: checkmark", "default": true, "info": "Unticked = cross" },
        { "type": "checkbox", "id": "them", "label": "Their column: checkmark", "default": false, "info": "Unticked = cross" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FreshSeal comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "Benefit", "us": true, "them": false } },
        { "type": "row", "settings": { "label": "Benefit", "us": true, "them": false } },
        { "type": "row", "settings": { "label": "Benefit", "us": true, "them": false } },
        { "type": "row", "settings": { "label": "Benefit", "us": false, "them": true } }
      ]
    }
  ]
}
{% endschema %}
