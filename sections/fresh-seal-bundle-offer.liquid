{%- comment -%}
  Fresh Seal — Bundle offer with order bump
  Hero bundle (machine + bags) + optional bump (+more bags) framed as
  "unlock free shipping". Prices, copy and products all editable in Shopify.
  Adds items to cart via AJAX; falls back to a standard form if JS is off.
{%- endcomment -%}

{%- liquid
  assign main_product = section.settings.main_product
  assign bump_product = section.settings.bump_product
  assign main_vid = ''
  assign bump_vid = ''
  if main_product != blank and main_product.first_available_variant
    assign main_vid = main_product.selected_or_first_available_variant.id
  endif
  if bump_product != blank and bump_product.first_available_variant
    assign bump_vid = bump_product.selected_or_first_available_variant.id
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-accent-dark: {{ section.settings.accent_color_dark }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
    --fs-card: {{ section.settings.card_color }};
  }
  .fs-bundle-{{ section.id }} {
    background: var(--fs-bg); color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-bundle-{{ section.id }} .fs-bundle__card {
    max-width: 560px; margin: 0 auto; background: var(--fs-card);
    border-radius: 20px; padding: 26px 22px 28px; border: 1px solid rgba(0,0,0,.06);
    box-shadow: 0 14px 40px rgba(0,0,0,.06);
  }
  .fs-bundle-{{ section.id }} .fs-bundle__flag { display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #fff; background: var(--fs-accent); padding: 5px 12px; border-radius: 999px; margin-bottom: 14px; }
  .fs-bundle-{{ section.id }} .fs-bundle__title { font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin: 0 0 8px; }
  .fs-bundle-{{ section.id }} .fs-bundle__desc { font-size: 15px; line-height: 1.5; opacity: .82; margin: 0 0 18px; }
  .fs-bundle-{{ section.id }} .fs-bundle__price { display: flex; align-items: baseline; gap: 10px; margin: 0 0 18px; flex-wrap: wrap; }
  .fs-bundle-{{ section.id }} .fs-bundle__price .now { font-size: 32px; font-weight: 800; color: var(--fs-accent-dark); }
  .fs-bundle-{{ section.id }} .fs-bundle__price .was { font-size: 17px; text-decoration: line-through; opacity: .5; }
  .fs-bundle-{{ section.id }} .fs-bundle__bump {
    display: flex; gap: 12px; align-items: flex-start;
    border: 2px dashed var(--fs-accent); border-radius: 14px;
    padding: 14px 16px; margin: 0 0 18px; cursor: pointer;
    background: rgba(45,157,120,.05);
  }
  .fs-bundle-{{ section.id }} .fs-bundle__bump input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--fs-accent); flex: none; }
  .fs-bundle-{{ section.id }} .fs-bundle__bump-title { font-weight: 800; font-size: 15px; margin: 0 0 3px; }
  .fs-bundle-{{ section.id }} .fs-bundle__bump-desc { font-size: 13px; line-height: 1.45; opacity: .82; margin: 0; }
  .fs-bundle-{{ section.id }} .fs-bundle__bump-price { font-weight: 800; color: var(--fs-accent-dark); }
  .fs-bundle-{{ section.id }} .fs-bundle__ship {
    display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700;
    padding: 12px 14px; border-radius: 12px; margin: 0 0 18px;
    background: rgba(45,157,120,.1); color: var(--fs-accent-dark);
  }
  .fs-bundle-{{ section.id }} .fs-bundle__ship.locked { background: rgba(0,0,0,.05); color: inherit; opacity: .8; }
  .fs-bundle-{{ section.id }} .fs-bundle__total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; margin: 0 0 16px; }
  .fs-bundle-{{ section.id }} .fs-bundle__total b { font-size: 24px; font-weight: 800; }
  .fs-bundle-{{ section.id }} .fs-bundle__cta {
    display: flex; align-items: center; justify-content: center;
    width: 100%; min-height: 56px; padding: 0 24px;
    background: var(--fs-accent); color: #fff; font-size: 18px; font-weight: 800;
    border: none; border-radius: 12px; cursor: pointer;
    transition: background .18s ease, transform .1s ease;
  }
  .fs-bundle-{{ section.id }} .fs-bundle__cta:hover { background: var(--fs-accent-dark); }
  .fs-bundle-{{ section.id }} .fs-bundle__cta:active { transform: translateY(1px); }
  .fs-bundle-{{ section.id }} .fs-bundle__cta[disabled] { opacity: .6; cursor: default; }
  .fs-bundle-{{ section.id }} .fs-bundle__fine { text-align: center; font-size: 12px; opacity: .6; margin: 12px 0 0; }
  @media screen and (min-width: 750px) {
    .fs-bundle-{{ section.id }} .fs-bundle__title { font-size: 30px; }
  }
{%- endstyle -%}

<div class="fs-bundle-{{ section.id }}" id="fs-bundle">
  <div class="page-width">
    <form
      class="fs-bundle__card"
      id="fs-bundle-form-{{ section.id }}"
      action="{{ routes.cart_add_url }}"
      method="post"
      data-main-vid="{{ main_vid }}"
      data-bump-vid="{{ bump_vid }}"
      data-main-price="{{ section.settings.main_price_cents }}"
      data-bump-price="{{ section.settings.bump_price_cents }}"
      data-free-ship-threshold="{{ section.settings.free_ship_cents }}"
    >
      {%- if section.settings.flag != blank -%}<span class="fs-bundle__flag">{{ section.settings.flag }}</span>{%- endif -%}
      <h2 class="fs-bundle__title">{{ section.settings.title }}</h2>
      {%- if section.settings.description != blank -%}<p class="fs-bundle__desc">{{ section.settings.description }}</p>{%- endif -%}

      <div class="fs-bundle__price">
        <span class="now">{{ section.settings.main_price_label }}</span>
        {%- if section.settings.main_compare_label != blank -%}<span class="was">{{ section.settings.main_compare_label }}</span>{%- endif -%}
      </div>

      {%- if section.settings.enable_bump -%}
        <label class="fs-bundle__bump" for="fs-bump-{{ section.id }}">
          <input type="checkbox" id="fs-bump-{{ section.id }}" data-bump-toggle>
          <span>
            <p class="fs-bundle__bump-title">{{ section.settings.bump_title }} <span class="fs-bundle__bump-price">+{{ section.settings.bump_price_label }}</span></p>
            <p class="fs-bundle__bump-desc">{{ section.settings.bump_description }}</p>
          </span>
        </label>
      {%- endif -%}

      <div class="fs-bundle__ship locked" data-ship-msg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 13h11V6H3v7Zm11 0 3-4h4l-1 4M6 18a2 2 0 1 0 0-.01M18 18a2 2 0 1 0 0-.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span data-ship-text>{{ section.settings.ship_locked_text }}</span>
      </div>

      <div class="fs-bundle__total">
        <span>Your total</span>
        <b data-total-label>{{ section.settings.main_price_label }}</b>
      </div>

      <button type="submit" class="fs-bundle__cta" data-bundle-cta>
        <span data-cta-text>{{ section.settings.cta_label }}</span>
      </button>

      {%- if section.settings.fine_print != blank -%}<p class="fs-bundle__fine">{{ section.settings.fine_print }}</p>{%- endif -%}
    </form>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('fs-bundle-form-{{ section.id }}');
    if (!form) return;
    var bump = form.querySelector('[data-bump-toggle]');
    var shipBox = form.querySelector('[data-ship-msg]');
    var shipText = form.querySelector('[data-ship-text]');
    var totalLabel = form.querySelector('[data-total-label]');
    var ctaText = form.querySelector('[data-cta-text]');
    var cta = form.querySelector('[data-bundle-cta]');

    var mainVid = form.dataset.mainVid;
    var bumpVid = form.dataset.bumpVid;
    var mainPrice = parseInt(form.dataset.mainPrice || '0', 10);
    var bumpPrice = parseInt(form.dataset.bumpPrice || '0', 10);
    var threshold = parseInt(form.dataset.freeShipThreshold || '0', 10);

    var CURRENCY = {{ shop.currency | json }};
    var LOCKED_TXT = {{ section.settings.ship_locked_text | json }};
    var UNLOCKED_TXT = {{ section.settings.ship_unlocked_text | json }};
    var CTA_TXT = {{ section.settings.cta_label | json }};
    var CTA_TMPL = {{ section.settings.cta_total_suffix | json }}; // e.g. " — {total}"

    function money(cents) {
      var v = (cents / 100).toFixed(2).replace(/\.00$/, '');
      return 'R' + v;
    }
    function update() {
      var withBump = bump && bump.checked;
      var total = mainPrice + (withBump ? bumpPrice : 0);
      if (totalLabel) totalLabel.textContent = money(total);
      if (ctaText) ctaText.textContent = CTA_TXT + (CTA_TMPL ? CTA_TMPL.replace('{total}', money(total)) : '');
      var free = threshold > 0 && total >= threshold;
      if (shipBox) shipBox.classList.toggle('locked', !free);
      if (shipText) shipText.textContent = free ? UNLOCKED_TXT : LOCKED_TXT;
    }
    if (bump) bump.addEventListener('change', update);
    update();

    form.addEventListener('submit', function (e) {
      if (!mainVid) return; // no product mapped → let native form/redirect happen
      e.preventDefault();
      var items = [{ id: parseInt(mainVid, 10), quantity: 1 }];
      if (bump && bump.checked && bumpVid) items.push({ id: parseInt(bumpVid, 10), quantity: 1 });
      cta.setAttribute('disabled', '');
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function (r) { return r.json(); })
      .then(function () { window.location.href = '{{ routes.cart_url }}'; })
      .catch(function () { cta.removeAttribute('disabled'); form.submit(); });
    });
  })();
</script>

{% schema %}
{
  "name": "Fresh Seal — Bundle offer",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "header", "content": "Hero bundle" },
    { "type": "text", "id": "flag", "label": "Flag badge", "default": "Your starter bundle" },
    { "type": "text", "id": "title", "label": "Title", "default": "Fresh Seal 4-in-1 Sealer + 51 bags" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Save R200 vs buying separate. The machine plus 51 bags — everything you need to seal your first bulk shop the day it arrives." },
    { "type": "product", "id": "main_product", "label": "Bundle product", "info": "Adds this product's variant to cart. Leave blank to send the button to a custom link/cart." },
    { "type": "text", "id": "main_price_label", "label": "Price (display)", "default": "R599" },
    { "type": "text", "id": "main_compare_label", "label": "Compare-at (display)", "default": "R799" },
    { "type": "number", "id": "main_price_cents", "label": "Price in cents (for totals)", "info": "R599 = 59900. Used for the live total + free-shipping logic.", "default": 59900 },
    { "type": "header", "content": "Order bump (unlock free shipping)" },
    { "type": "checkbox", "id": "enable_bump", "label": "Enable order bump", "default": true },
    { "type": "text", "id": "bump_title", "label": "Bump title", "default": "Add 50 extra bags" },
    { "type": "textarea", "id": "bump_description", "label": "Bump description", "default": "Unlock FREE SHIPPING on your whole order — R599 + R149 = R748, clearing the R700 threshold. The extra bags basically ship themselves." },
    { "type": "product", "id": "bump_product", "label": "Bump product" },
    { "type": "text", "id": "bump_price_label", "label": "Bump price (display)", "default": "R149" },
    { "type": "number", "id": "bump_price_cents", "label": "Bump price in cents", "default": 14900 },
    { "type": "header", "content": "Free shipping" },
    { "type": "number", "id": "free_ship_cents", "label": "Free-shipping threshold (cents)", "info": "R700 = 70000.", "default": 70000 },
    { "type": "text", "id": "ship_locked_text", "label": "Message before threshold", "default": "Add the bags to unlock FREE shipping" },
    { "type": "text", "id": "ship_unlocked_text", "label": "Message after threshold", "default": "🎉 FREE shipping unlocked!" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "cta_total_suffix", "label": "Append total to button", "info": "Use {total} as a placeholder, e.g. ' — {total}'. Leave blank for none.", "default": " — {total}" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "30-day money-back guarantee · 12-month warranty · Ships across SA" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "accent_color_dark", "label": "Accent dark", "default": "#1e7d5f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F5F5" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [ { "name": "Fresh Seal — Bundle offer" } ]
}
{% endschema %}
