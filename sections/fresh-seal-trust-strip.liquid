{%- comment -%}
  Fresh Seal — Trust strip (shipping, warranty, returns)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
  }
  .fs-trust-{{ section.id }} {
    background: var(--fs-bg); color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-trust-{{ section.id }} .fs-trust__grid {
    display: grid; grid-template-columns: 1fr; gap: 14px;
  }
  .fs-trust-{{ section.id }} .fs-trust__item {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 18px; border-radius: 14px; background: {{ section.settings.card_color }};
    border: 1px solid rgba(0,0,0,.05);
  }
  .fs-trust-{{ section.id }} .fs-trust__icon {
    flex: none; width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(45,157,120,.12); color: var(--fs-accent);
  }
  .fs-trust-{{ section.id }} .fs-trust__t { font-weight: 800; font-size: 15px; margin: 0; }
  .fs-trust-{{ section.id }} .fs-trust__d { font-size: 13px; opacity: .72; margin: 2px 0 0; }
  @media screen and (min-width: 750px) {
    .fs-trust-{{ section.id }} .fs-trust__grid { grid-template-columns: repeat({{ section.blocks.size }}, 1fr); }
  }
{%- endstyle -%}

{%- assign icons = 'truck,shield,refresh,leaf,lock,star' | split: ',' -%}
<div class="fs-trust-{{ section.id }}">
  <div class="page-width">
    <div class="fs-trust__grid">
      {%- for block in section.blocks -%}
        <div class="fs-trust__item" {{ block.shopify_attributes }}>
          <span class="fs-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'refresh' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8M20 4v4h-4M20 12a8 8 0 0 1-13.7 5.6L4 16m0 4v-4h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'leaf' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 20c8 2 15-3 15-13 0 0-11-2-14 4-1.6 3.2.5 6 .5 6M8 16s3-4 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'lock' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              {%- when 'star' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="m12 3 2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {%- else -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 13h11V6H3v7Zm11 0 3-4h4l-1 4M6 18a2 2 0 1 0 0-.01M18 18a2 2 0 1 0 0-.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </span>
          <span>
            <p class="fs-trust__t">{{ block.settings.title }}</p>
            {%- if block.settings.description != blank -%}<p class="fs-trust__d">{{ block.settings.description }}</p>{%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Seal — Trust strip",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#F5F5F5" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck (shipping)" },
          { "value": "shield", "label": "Shield (warranty)" },
          { "value": "refresh", "label": "Refresh (returns)" },
          { "value": "leaf", "label": "Leaf (freshness)" },
          { "value": "lock", "label": "Lock (secure)" },
          { "value": "star", "label": "Star (rating)" }
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free SA shipping" },
        { "type": "text", "id": "description", "label": "Description", "default": "On orders over R700" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Fast SA shipping", "description": "Free over R700 · 2–4 days" } },
        { "type": "item", "settings": { "icon": "shield", "title": "12-month warranty", "description": "Covered, no fine print" } },
        { "type": "item", "settings": { "icon": "refresh", "title": "30-day guarantee", "description": "Love it or your money back" } },
        { "type": "item", "settings": { "icon": "leaf", "title": "5× longer freshness", "description": "Less waste, more savings" } }
      ]
    }
  ]
}
{% endschema %}
