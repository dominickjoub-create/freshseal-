{%- comment -%}
  Fresh Seal — FAQ accordion (native <details>, no JS required)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
    --fs-card: {{ section.settings.card_color }};
  }
  .fs-faq-{{ section.id }} {
    background: var(--fs-bg); color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-faq-{{ section.id }} .fs-faq__title { font-size: 28px; font-weight: 800; letter-spacing: -.02em; text-align: center; margin: 0 0 26px; }
  .fs-faq-{{ section.id }} .fs-faq__list { max-width: 720px; margin: 0 auto; display: grid; gap: 10px; }
  .fs-faq-{{ section.id }} details {
    background: var(--fs-card); border-radius: 14px; border: 1px solid rgba(0,0,0,.06); overflow: hidden;
  }
  .fs-faq-{{ section.id }} summary {
    list-style: none; cursor: pointer; padding: 18px 20px;
    font-size: 16px; font-weight: 700; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .fs-faq-{{ section.id }} summary::-webkit-details-marker { display: none; }
  .fs-faq-{{ section.id }} summary .fs-faq__icon { flex: none; transition: transform .2s ease; color: var(--fs-accent); }
  .fs-faq-{{ section.id }} details[open] summary .fs-faq__icon { transform: rotate(45deg); }
  .fs-faq-{{ section.id }} .fs-faq__answer { padding: 0 20px 20px; font-size: 15px; line-height: 1.6; opacity: .85; }
  .fs-faq-{{ section.id }} .fs-faq__answer > *:first-child { margin-top: 0; }
  @media screen and (min-width: 750px) {
    .fs-faq-{{ section.id }} .fs-faq__title { font-size: 34px; }
  }
{%- endstyle -%}

<div class="fs-faq-{{ section.id }}" id="fs-faq-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}<h2 class="fs-faq__title">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="fs-faq__list">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <svg class="fs-faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </summary>
          <div class="fs-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fs-faq-{{ section.id }}');
    if (!root) return;
    var items = root.querySelectorAll('details');
    items.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) return;
        items.forEach(function (other) { if (other !== d) other.removeAttribute('open'); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Fresh Seal — FAQ",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Questions? Answered." },
    { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#F5F5F5" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does food actually stay fresh?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Vacuum-sealed food lasts up to 5× longer than in normal packaging — meat and cheese for weeks in the fridge, months in the freezer, with no freezer burn.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Does it work with any bag?", "answer": "<p>Yes. Any bag, roll or pouch — textured, embossed, generic, whatever's cheapest at Makro. You're never locked into branded refills.</p>" } },
        { "type": "faq", "settings": { "question": "What about the 12cm seal width?", "answer": "<p>That's precision portioning, not a limit. 12cm is ideal for single servings, braai packs and meal prep — portions seal flat, stack neatly and defrost only what you need.</p>" } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "<p>We ship from South Africa — no customs, no surprises. Most orders arrive within 2–4 working days, and shipping is FREE over R700.</p>" } },
        { "type": "faq", "settings": { "question": "What's your return policy?", "answer": "<p>30-day money-back guarantee, plus a 12-month warranty. If it's not for you, send it back and we'll refund you — no forms, no fights.</p>" } }
      ]
    }
  ]
}
{% endschema %}
