{%- comment -%}
  Fresh Seal — Horizontal scrolling carousel (product range / bundles)
  CSS scroll-snap. 1.2–1.5 cards on mobile, 3–4 on desktop.
  Each card can pull live product data (image/title/price) or use manual overrides.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-accent-dark: {{ section.settings.accent_color_dark }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
    --fs-card: {{ section.settings.card_color }};
  }
  .fs-carousel-{{ section.id }} {
    background: var(--fs-bg);
    color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-carousel-{{ section.id }} .fs-car__head { max-width: 40em; margin: 0 0 22px; }
  .fs-carousel-{{ section.id }} .fs-car__title { font-size: 28px; font-weight: 800; letter-spacing: -.02em; margin: 0 0 8px; }
  .fs-carousel-{{ section.id }} .fs-car__intro { font-size: 16px; opacity: .8; margin: 0; }
  .fs-carousel-{{ section.id }} .fs-car__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 6px 0 16px;
    scroll-padding-left: 0;
  }
  .fs-carousel-{{ section.id }} .fs-car__track::-webkit-scrollbar { display: none; }
  .fs-carousel-{{ section.id }} .fs-car__card {
    scroll-snap-align: start;
    flex: 0 0 78%;
    background: var(--fs-card);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(0,0,0,.06);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .fs-carousel-{{ section.id }} .fs-car__card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,.08); }
  .fs-carousel-{{ section.id }} .fs-car__media { aspect-ratio: 1/1; background: #fff; overflow: hidden; }
  .fs-carousel-{{ section.id }} .fs-car__media img, .fs-carousel-{{ section.id }} .fs-car__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fs-carousel-{{ section.id }} .fs-car__body { padding: 16px 16px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .fs-carousel-{{ section.id }} .fs-car__badge { align-self: flex-start; font-size: 11px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--fs-accent-dark); background: rgba(45,157,120,.12); padding: 4px 9px; border-radius: 999px; }
  .fs-carousel-{{ section.id }} .fs-car__name { font-size: 16px; font-weight: 700; margin: 4px 0 0; line-height: 1.3; }
  .fs-carousel-{{ section.id }} .fs-car__price { display: flex; align-items: baseline; gap: 8px; margin-top: 2px; }
  .fs-carousel-{{ section.id }} .fs-car__price .now { font-size: 18px; font-weight: 800; color: var(--fs-accent-dark); }
  .fs-carousel-{{ section.id }} .fs-car__price .was { font-size: 14px; text-decoration: line-through; opacity: .5; }
  .fs-carousel-{{ section.id }} .fs-car__cta {
    margin-top: auto;
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 46px; padding: 0 16px;
    background: var(--fs-accent); color: #fff;
    font-size: 15px; font-weight: 700; border-radius: 10px;
    text-decoration: none; border: none; cursor: pointer;
    transition: background .18s ease;
  }
  .fs-carousel-{{ section.id }} .fs-car__cta:hover { background: var(--fs-accent-dark); }
  .fs-carousel-{{ section.id }} .fs-car__hint { font-size: 13px; opacity: .55; margin: 4px 0 0; }
  @media screen and (min-width: 750px) {
    .fs-carousel-{{ section.id }} .fs-car__title { font-size: 34px; }
    .fs-carousel-{{ section.id }} .fs-car__card { flex-basis: calc((100% - 48px) / {{ section.settings.cards_desktop }}); }
    .fs-carousel-{{ section.id }} .fs-car__hint { display: none; }
  }
{%- endstyle -%}

<div class="fs-carousel-{{ section.id }}">
  <div class="page-width">
    <div class="fs-car__head">
      {%- if section.settings.title != blank -%}<h2 class="fs-car__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="fs-car__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
    <div class="fs-car__track" role="list">
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}
        {%- liquid
          assign card_title = block.settings.title
          assign card_url = block.settings.link
          assign card_now = block.settings.price
          assign card_was = block.settings.compare_price
          if prod != blank
            if card_title == blank
              assign card_title = prod.title
            endif
            if card_url == blank
              assign card_url = prod.url
            endif
            if card_now == blank
              assign card_now = prod.price | money
            endif
            if card_was == blank and prod.compare_at_price > prod.price
              assign card_was = prod.compare_at_price | money
            endif
          endif
        -%}
        <a class="fs-car__card" role="listitem" href="{{ card_url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="fs-car__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 78vw', widths: '300, 450, 600, 800', alt: card_title | escape }}
            {%- elsif prod != blank and prod.featured_image -%}
              {{ prod.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 78vw', widths: '300, 450, 600, 800', alt: card_title | escape }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="fs-car__body">
            {%- if block.settings.badge != blank -%}<span class="fs-car__badge">{{ block.settings.badge }}</span>{%- endif -%}
            <h3 class="fs-car__name">{{ card_title | default: 'Product' }}</h3>
            {%- if card_now != blank -%}
              <div class="fs-car__price">
                <span class="now">{{ card_now }}</span>
                {%- if card_was != blank -%}<span class="was">{{ card_was }}</span>{%- endif -%}
              </div>
            {%- endif -%}
            <span class="fs-car__cta">{{ block.settings.cta_label | default: 'View' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    <p class="fs-car__hint">← Swipe to see more →</p>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Seal — Carousel",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "The Fresh Seal range" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Bundles and refills — swipe to build your kit." },
    { "type": "range", "id": "cards_desktop", "min": 3, "max": 4, "step": 1, "label": "Cards per screen (desktop)", "default": 3 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent (green)", "default": "#2D9D78" },
    { "type": "color", "id": "accent_color_dark", "label": "Accent dark", "default": "#248063" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#F5F5F5" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Pulls image, title and price automatically. Fields below override it." },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Best value" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "price", "label": "Price override", "info": "e.g. R599" },
        { "type": "text", "id": "compare_price", "label": "Compare-at override", "info": "e.g. R999" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "View" },
        { "type": "url", "id": "link", "label": "Button link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — Carousel",
      "blocks": [
        { "type": "card", "settings": { "badge": "Best value", "title": "Fresh Seal + 51 Bags", "price": "R599", "compare_price": "R999", "cta_label": "Add to cart" } },
        { "type": "card", "settings": { "badge": "Top up", "title": "50 Vacuum Bags", "price": "R149", "cta_label": "Add to cart" } },
        { "type": "card", "settings": { "badge": "Accessory", "title": "Bottle Stopper Set", "price": "R99", "cta_label": "Add to cart" } },
        { "type": "card", "settings": { "badge": "Refill", "title": "Roll Bag Refill", "price": "R199", "cta_label": "Add to cart" } }
      ]
    }
  ]
}
{% endschema %}
