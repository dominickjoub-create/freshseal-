{%- comment -%}
  Fresh Seal — Horizontal carousel (product range / bundles)
  A true left→right scroller: peeking cards, CSS scroll-snap, arrow buttons
  and drag. 1.2–1.5 cards mobile, 3–4 desktop. Each card editable in Shopify.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fs-accent: {{ section.settings.accent_color }};
    --fs-accent-dark: {{ section.settings.accent_color_dark }};
    --fs-cta: {{ section.settings.cta_color }};
    --fs-sale: {{ section.settings.sale_color }};
    --fs-text: {{ section.settings.text_color }};
    --fs-bg: {{ section.settings.bg_color }};
    --fs-card: {{ section.settings.card_color }};
  }
  .fs-carousel-{{ section.id }} {
    background: var(--fs-bg);
    color: var(--fs-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    font-family: 'Helvetica Neue', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .fs-carousel-{{ section.id }} .fs-car__topbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin: 0 0 20px; }
  .fs-carousel-{{ section.id }} .fs-car__title { font-size: 26px; font-weight: 800; letter-spacing: -.02em; margin: 0 0 6px; }
  .fs-carousel-{{ section.id }} .fs-car__intro { font-size: 15px; opacity: .78; margin: 0; }
  .fs-carousel-{{ section.id }} .fs-car__arrows { display: none; gap: 8px; flex: none; }
  .fs-carousel-{{ section.id }} .fs-car__arrow {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid rgba(0,0,0,.14); background: #fff; color: var(--fs-text);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: background .15s ease, opacity .15s ease, border-color .15s ease;
  }
  .fs-carousel-{{ section.id }} .fs-car__arrow:hover { background: var(--fs-accent); color: #fff; border-color: var(--fs-accent); }
  .fs-carousel-{{ section.id }} .fs-car__arrow[disabled] { opacity: .3; cursor: default; }
  .fs-carousel-{{ section.id }} .fs-car__arrow[disabled]:hover { background: #fff; color: var(--fs-text); border-color: rgba(0,0,0,.14); }

  .fs-carousel-{{ section.id }} .fs-car__viewport { position: relative; }
  .fs-carousel-{{ section.id }} .fs-car__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 6px 2px 18px;
    scroll-behavior: smooth;
    cursor: grab;
  }
  .fs-carousel-{{ section.id }} .fs-car__track.is-dragging { cursor: grabbing; scroll-behavior: auto; scroll-snap-type: none; }
  .fs-carousel-{{ section.id }} .fs-car__track::-webkit-scrollbar { display: none; }
  .fs-carousel-{{ section.id }} .fs-car__card {
    scroll-snap-align: start;
    flex: 0 0 85%;
    background: var(--fs-card);
    border-radius: 18px;
    overflow: hidden;
    display: flex; flex-direction: column;
    text-decoration: none; color: inherit;
    border: 1px solid rgba(0,0,0,.06);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .fs-carousel-{{ section.id }} .fs-car__card:hover { box-shadow: 0 14px 34px rgba(0,0,0,.09); }
  .fs-carousel-{{ section.id }} .fs-car__namelink { color: inherit; text-decoration: none; }
  .fs-carousel-{{ section.id }} .fs-car__namelink:hover { text-decoration: underline; }
  .fs-carousel-{{ section.id }} .fs-car__form { margin: auto 0 0; display: flex; }
  .fs-carousel-{{ section.id }} .fs-car__form .fs-car__cta { width: 100%; margin-top: 0; }
  .fs-carousel-{{ section.id }} .fs-car__cta[aria-busy="true"] { opacity: .7; pointer-events: none; }
  .fs-carousel-{{ section.id }} .fs-car__media { position: relative; aspect-ratio: 1/1; background: #fff; overflow: hidden; display: block; }
  .fs-carousel-{{ section.id }} .fs-car__media img, .fs-carousel-{{ section.id }} .fs-car__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fs-carousel-{{ section.id }} .fs-car__badge {
    position: absolute; top: 14px; left: 14px;
    font-size: 12px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
    color: #fff; background: var(--fs-accent); padding: 7px 13px; border-radius: 8px;
  }
  .fs-carousel-{{ section.id }} .fs-car__body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .fs-carousel-{{ section.id }} .fs-car__name { font-size: 18px; font-weight: 800; margin: 0; line-height: 1.25; }
  .fs-carousel-{{ section.id }} .fs-car__parts { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 2px 0; padding: 0; list-style: none; }
  .fs-carousel-{{ section.id }} .fs-car__parts li { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 600; }
  .fs-carousel-{{ section.id }} .fs-car__parts .n {
    flex: none; min-width: 24px; height: 24px; padding: 0 4px; border-radius: 999px;
    background: var(--fs-text); color: #fff; font-size: 12px; font-weight: 800;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .fs-carousel-{{ section.id }} .fs-car__stars { color: #f5b301; font-size: 15px; letter-spacing: 1px; }
  .fs-carousel-{{ section.id }} .fs-car__stars .count { color: rgba(0,0,0,.5); font-size: 13px; margin-left: 4px; }
  .fs-carousel-{{ section.id }} .fs-car__price { display: flex; align-items: baseline; gap: 9px; }
  .fs-carousel-{{ section.id }} .fs-car__price .was { font-size: 15px; text-decoration: line-through; opacity: .5; }
  .fs-carousel-{{ section.id }} .fs-car__price .now { font-size: 21px; font-weight: 800; color: var(--fs-sale); }
  .fs-carousel-{{ section.id }} .fs-car__save { font-size: 13px; font-weight: 700; opacity: .7; }
  .fs-carousel-{{ section.id }} .fs-car__cta {
    margin-top: auto;
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 50px; padding: 0 18px; gap: 8px;
    background: var(--fs-cta); color: #fff;
    font-size: 15px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; border-radius: 12px;
    text-decoration: none; border: none; cursor: pointer;
    transition: filter .18s ease;
  }
  .fs-carousel-{{ section.id }} .fs-car__cta:hover { filter: brightness(.92); }
  .fs-carousel-{{ section.id }} .fs-car__hint { font-size: 13px; opacity: .5; margin: 2px 0 0; text-align: center; }

  @media screen and (min-width: 750px) {
    .fs-carousel-{{ section.id }} .fs-car__title { font-size: 32px; }
    .fs-carousel-{{ section.id }} .fs-car__arrows { display: flex; }
    .fs-carousel-{{ section.id }} .fs-car__card {
      {%- if section.settings.cards_desktop == '2' -%}
        flex-basis: calc(50% - 24px);
      {%- else -%}
        flex-basis: calc(62% - 16px);
      {%- endif -%}
    }
    .fs-carousel-{{ section.id }} .fs-car__hint { display: none; }
  }
  @media screen and (max-width: 480px) {
    .fs-carousel-{{ section.id }} .fs-car__title { font-size: 23px; }
    .fs-carousel-{{ section.id }} .fs-car__card { flex-basis: 82%; }
    .fs-carousel-{{ section.id }} .fs-car__body { padding: 16px 16px 18px; gap: 7px; }
    .fs-carousel-{{ section.id }} .fs-car__name { font-size: 16.5px; }
    .fs-carousel-{{ section.id }} .fs-car__cta { min-height: 48px; font-size: 14px; }
  }
{%- endstyle -%}

<div class="fs-carousel-{{ section.id }}" id="fs-carousel-{{ section.id }}">
  <div class="page-width">
    <div class="fs-car__topbar">
      <div>
        {%- if section.settings.title != blank -%}<h2 class="fs-car__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="fs-car__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
      <div class="fs-car__arrows">
        <button type="button" class="fs-car__arrow" data-dir="prev" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="fs-car__arrow" data-dir="next" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <div class="fs-car__viewport">
      <div class="fs-car__track" data-track role="list">
        {%- for block in section.blocks -%}
          {%- assign prod = block.settings.product -%}
          {%- liquid
            assign card_title = block.settings.title
            assign card_url = block.settings.link
            assign card_now = block.settings.price
            assign card_was = block.settings.compare_price
            assign card_vid = ''
            if prod != blank
              if card_title == blank
                assign card_title = prod.title
              endif
              if card_url == blank
                assign card_url = prod.url
              endif
              if card_now == blank
                assign card_now = prod.price | money
              endif
              if card_was == blank and prod.compare_at_price > prod.price
                assign card_was = prod.compare_at_price | money
              endif
              if prod.available
                assign card_vid = prod.selected_or_first_available_variant.id
              endif
            endif
          -%}
          <div class="fs-car__card" role="listitem" {{ block.shopify_attributes }}>
            <a class="fs-car__media" href="{{ card_url | default: '#' }}"{% if card_url == blank %} tabindex="-1" aria-hidden="true"{% endif %}>
              {%- if block.settings.badge != blank -%}<span class="fs-car__badge">{{ block.settings.badge }}</span>{%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 80vw', widths: '300, 450, 600, 800', alt: card_title | escape }}
              {%- elsif prod != blank and prod.featured_image -%}
                {{ prod.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 80vw', widths: '300, 450, 600, 800', alt: card_title | escape }}
              {%- else -%}
                {{ 'product-apparel-2' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="fs-car__body">
              <h3 class="fs-car__name"><a href="{{ card_url | default: '#' }}" class="fs-car__namelink">{{ card_title | default: 'Product' }}</a></h3>
              {%- if block.settings.components != blank -%}
                <ul class="fs-car__parts">
                  {%- assign comps = block.settings.components | newline_to_br | split: '<br />' -%}
                  {%- for comp in comps -%}
                    {%- assign cparts = comp | strip | split: '|' -%}
                    {%- if cparts[0] != blank -%}
                      <li>
                        {%- if cparts.size > 1 -%}
                          <span class="n">{{ cparts[0] | strip }}</span><span>{{ cparts[1] | strip }}</span>
                        {%- else -%}
                          <span>{{ cparts[0] | strip }}</span>
                        {%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.rating > 0 -%}
                <div class="fs-car__stars">{% assign r = block.settings.rating | round %}{% for i in (1..5) %}{% if i <= r %}★{% else %}☆{% endif %}{% endfor %}{% if block.settings.reviews != blank %}<span class="count">({{ block.settings.reviews }})</span>{% endif %}</div>
              {%- endif -%}
              {%- if card_now != blank -%}
                <div class="fs-car__price">
                  {%- if card_was != blank -%}<span class="was">{{ card_was }}</span>{%- endif -%}
                  <span class="now">{{ card_now }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.save_line != blank -%}<div class="fs-car__save">{{ block.settings.save_line }}</div>{%- endif -%}
              {%- if card_vid != blank -%}
                <form class="fs-car__form" action="{{ routes.cart_add_url }}" method="post" data-fs-cart-form>
                  <input type="hidden" name="id" value="{{ card_vid }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="fs-car__cta" data-fs-cart-btn>{{ block.settings.cta_label | default: 'Add to cart' }} <span aria-hidden="true">→</span></button>
                </form>
              {%- else -%}
                <a class="fs-car__cta" href="{{ card_url | default: '#' }}">{{ block.settings.cta_label | default: 'View' }} <span aria-hidden="true">→</span></a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <p class="fs-car__hint">← Swipe to explore →</p>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fs-carousel-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-track]');
    var prev = root.querySelector('[data-dir="prev"]');
    var next = root.querySelector('[data-dir="next"]');
    if (!track) return;

    function step() {
      var card = track.querySelector('.fs-car__card');
      if (!card) return track.clientWidth * 0.8;
      var gap = parseInt(getComputedStyle(track).columnGap || '16', 10) || 16;
      return card.getBoundingClientRect().width + gap;
    }
    function sync() {
      if (!prev || !next) return;
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();

    // drag-to-scroll (desktop mouse)
    var down = false, startX = 0, startLeft = 0, moved = false;
    track.addEventListener('mousedown', function (e) {
      down = true; moved = false; startX = e.pageX; startLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    window.addEventListener('mouseup', function () {
      if (down) { down = false; track.classList.remove('is-dragging'); }
    });
    track.addEventListener('mousemove', function (e) {
      if (!down) return;
      var dx = e.pageX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startLeft - dx;
    });
    track.addEventListener('click', function (e) {
      if (moved) { e.preventDefault(); }
    });

    // AJAX add-to-cart for each card
    root.querySelectorAll('[data-fs-cart-form]').forEach(function (form) {
      var btn = form.querySelector('[data-fs-cart-btn]');
      var label = btn ? btn.innerHTML : '';
      form.addEventListener('submit', function (e) {
        if (moved) { e.preventDefault(); return; }
        if (!window.fetch) return; // native form post still works without JS
        e.preventDefault();
        if (btn) { btn.setAttribute('aria-busy', 'true'); btn.textContent = 'Adding…'; }
        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: form.querySelector('[name="id"]').value, quantity: 1 })
        })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
        .then(function () { window.location.href = '{{ routes.cart_url }}'; })
        .catch(function () { form.submit(); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Fresh Seal — Carousel",
  "tag": "section",
  "class": "fs-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Fresh Seal Bundles" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Save when you bundle the machine with bags." },
    { "type": "select", "id": "cards_desktop", "label": "Cards visible (desktop)", "options": [ { "value": "1.5", "label": "About 1.5 (large cards)" }, { "value": "2", "label": "2 + a peek" } ], "default": "1.5" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent / badge (green)", "default": "#2D9D78" },
    { "type": "color", "id": "accent_color_dark", "label": "Accent dark", "default": "#1e7d5f" },
    { "type": "color", "id": "cta_color", "label": "Button colour", "default": "#2D9D78" },
    { "type": "color", "id": "sale_color", "label": "Sale price colour", "default": "#2D9D78" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#F7F5F2" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Required for the Add to cart button to work — it pulls image, title and price, and adds this product to the cart. Without a product the button becomes a link. Fields below override the display values." },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Best value" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "components", "label": "What's in the bundle (Qty | Item, one per line)", "info": "e.g. 1 | Fresh Seal Machine — shows as a numbered chip.", "default": "1 | Fresh Seal Machine\n51 | Vacuum Bags" },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Star rating (0 = hide)", "default": 5 },
        { "type": "text", "id": "reviews", "label": "Review count", "default": "57" },
        { "type": "text", "id": "price", "label": "Price override", "info": "e.g. R599" },
        { "type": "text", "id": "compare_price", "label": "Compare-at override", "info": "e.g. R999" },
        { "type": "text", "id": "save_line", "label": "Save / shipping line", "default": "Save R400 · Free shipping" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
        { "type": "url", "id": "link", "label": "Button link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fresh Seal — Carousel",
      "blocks": [
        { "type": "card", "settings": { "badge": "Best seller", "title": "Starter Bundle", "components": "1 | Fresh Seal Machine\n51 | Vacuum Bags", "price": "R599", "compare_price": "R799", "save_line": "Save R200 vs buying separate" } },
        { "type": "card", "settings": { "badge": "Best value", "title": "Free-Shipping Bundle", "components": "1 | Fresh Seal Machine\n101 | Vacuum Bags", "price": "R748", "compare_price": "R948", "save_line": "Unlocks FREE shipping (over R700)" } },
        { "type": "card", "settings": { "badge": "Top up", "title": "Bag Refill Pack", "components": "50 | Vacuum Bags", "price": "R149", "save_line": "Works with any sealer", "rating": 0 } }
      ]
    }
  ]
}
{% endschema %}
